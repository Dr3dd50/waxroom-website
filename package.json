{
  "name": "waxroom-website",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build && vite build --ssr src/entry-server.tsx --outDir dist-ssr && node scripts/prerender.mjs",
    "lint": "oxlint",
    "preview": "vite preview",
    "sync:menu": "node scripts/sync-glossgenius.mjs",
    "sync:reviews": "node scripts/fetch-reviews.mjs",
    "sync:instagram": "node scripts/sync-instagram.mjs",
    "dashboard": "vite --config dashboard/vite.config.ts",
    "build:dashboard": "tsc -b && vite build --config dashboard/vite.config.ts",
    "port:glossgenius": "node scripts/port-glossgenius.mjs",
    "api": "tsx watch platform/api/src/server.ts",
    "test:api": "tsx --test platform/api/test/*.test.ts",
    "import:glossgenius": "tsx platform/api/scripts/import-glossgenius.ts",
    "build:native": "node scripts/build-native.mjs",
    "deploy:live": "node scripts/deploy-live.mjs",
    "dev:all": "node scripts/dev-all.mjs"
  },
  "dependencies": {
    "@aws-sdk/client-dynamodb": "^3.1149.0",
    "@aws-sdk/client-secrets-manager": "^3.1149.0",
    "@aws-sdk/lib-dynamodb": "^3.1149.0",
    "@gsap/react": "^2.1.2",
    "@hono/node-server": "^1.19.17",
    "@stripe/stripe-js": "^4.10.0",
    "gsap": "^3.15.0",
    "hono": "^4.13.13",
    "lenis": "^1.3.26",
    "posthog-js": "^1.438.7",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "stripe": "^17.7.0"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.7",
    "@vitejs/plugin-react": "^6.1.1",
    "aws-cdk": "^2.1145.0",
    "aws-cdk-lib": "^2.273.0",
    "constructs": "^10.8.1",
    "esbuild": "^0.28.2",
    "oxlint": "^1.81.0",
    "playwright-core": "1.56",
    "tsx": "^4.23.15",
    "typescript": "~6.0.2",
    "vite": "^8.3.0"
  }
}
